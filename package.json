{
  "name": "@sdstoehr/mcp-install",
  "version": "0.1.0",
  "description": "One-command install of MCP servers into Claude Desktop and Claude Code, with {{placeholder}} prompts for secrets.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "claude-code",
    "cli"
  ],
  "license": "MIT",
  "author": "Sebastian Stöhr",
  "type": "module",
  "bin": {
    "mcp-install": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdstoehr/mcp-install-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
